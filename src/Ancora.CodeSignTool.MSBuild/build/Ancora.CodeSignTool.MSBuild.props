<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <_ACST_TFM Condition=" '$(MSBuildRuntimeType)' != 'Core' ">net472</_ACST_TFM>
        <_ACST_TFM Condition=" '$(MSBuildRuntimeType)' == 'Core' ">net8.0</_ACST_TFM>
    </PropertyGroup>

    <UsingTask 
      AssemblyFile="$(MSBuildThisFileDirectory)../tasks/$(_ACST_TFM)/Ancora.CodeSignTool.MSBuild.dll"
      TaskName="Ancora.MSBuild.CodeSignTool" />
</Project>